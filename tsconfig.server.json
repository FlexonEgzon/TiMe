{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["server/**/*.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "paths": {
      "@server/*": ["./server/*"]
    }
  }
}
